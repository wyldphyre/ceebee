<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="ceebee"
        Arguments=""
        InstallLocation="C:\Program Files\Craig Reynolds\CeeBee">
    </Installer>
    <PackageInformation
        PackageName="CeeBee"
        PackageDisplayName="CeeBee"
        PublisherName="CN=Craig Reynolds"
        PublisherDisplayName="Craig Reynolds"
        Version="0.5.0.0"
        PackageDescription="Comic book reader">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.wyldphyre.ceebee"
                Description="Comic book reader"
                DisplayName="CeeBee"
                ExecutableName="ceebee"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>CeeBee</DisplayName>
            <PublisherDisplayName>Craig Reynolds</PublisherDisplayName>
            <Description>Comic book reader</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="ceebee.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
